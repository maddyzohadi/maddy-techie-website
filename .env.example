# ─── Site ────────────────────────────────────────────────────────────────────
# Used to build absolute URLs (metadata, sitemap, robots, JSON-LD). No domain
# should ever be hardcoded in blog code — it all reads from this instead.
NEXT_PUBLIC_SITE_URL=https://www.maddythetechie.com

# ─── Supabase (waitlist, blog) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY: Supabase's current server-side Secret API Key
# (Dashboard → Project Settings → API → Secret keys). Server-only — never
# reference this in client components or ship it to the browser bundle.
# Used by scripts/create-admin-user.mjs (the one-time admin setup script).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY: legacy server-side key, kept only for backward
# compatibility. scripts/create-admin-user.mjs falls back to this ONLY if
# SUPABASE_SECRET_KEY is unset. Also still read directly by the pre-existing
# app/api/chat/route.ts and app/api/telegram/webhook/route.ts (lead capture /
# conversation logging) — leave this set if those features already depend on
# it; removing it there is a separate, unrelated change.
SUPABASE_SERVICE_ROLE_KEY=
# Never commit real values for either key above, and never add them to any
# NEXT_PUBLIC_-prefixed variable or client ('use client') code.

# ─── Admin auth ──────────────────────────────────────────────────────────────
# ADMIN_PASSWORD: legacy shared-password gate. Kept only as a fallback during
# the migration to Supabase Auth — remove once you've confirmed you can log
# in at /admin/login with your Supabase account.
ADMIN_PASSWORD=
# ADMIN_EMAIL / ADMIN_INITIAL_PASSWORD: local, one-time variables read only
# by `node --env-file=.env.local scripts/create-admin-user.mjs` to create
# your Supabase Auth admin account. Never used by the running app, never
# committed, and safe to remove from .env.local once the script has run
# successfully.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ─── AI Assistant (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=

# ─── Services contact form (Resend) ─────────────────────────────────────────
# Sign up at https://resend.com, create an API key, and verify your sending domain.
# FROM address must match a verified domain in your Resend account.
# During local dev you can set FROM to: onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM_EMAIL=Maddy the Techie <noreply@maddythetechie.com>

# ─── Starter Kit email delivery ──────────────────────────────────────────────
# Set STARTER_KIT_PROVIDER to the service you choose, then fill in the key/ID.
# Supported options (see app/api/starter-kit/route.ts for integration examples):
#   kit | mailchimp | resend | supabase
STARTER_KIT_PROVIDER=
STARTER_KIT_API_KEY=
STARTER_KIT_API_SECRET=
STARTER_KIT_FORM_ID=
